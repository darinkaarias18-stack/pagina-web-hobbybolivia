// Prisma schema for Hobby Bolivia (MySQL)
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model SiteConfig {
  id              Int      @id @default(autoincrement())
  companyName     String   @default("Hobby Bolivia")
  subtitle        String?  @default("Repuestos y componentes de precisión para aviones a escala & aeromodelismo")
  domain          String   @default("https://hobbybolivia.com")
  logoUrl         String?  @db.VarChar(500)
  heroBannerUrl   String?  @db.VarChar(500)
  primaryColor    String   @default("#F85606")
  secondaryColor  String   @default("#161311")
  accentColor     String   @default("#D4A359")
  currency        String   @default("Bs.")
  whatsappNumber  String   @default("+591 77293446")
  topBarText      String   @default("Hobby Bolivia: Repuestos y componentes de precisión para aviones a escala | Envíos seguros a toda Bolivia")
  contactEmail    String   @default("contacto@hobbybolivia.com")
  themePreset     String?  @default("technest")
  cardStyle       String?  @default("with_button")
  desktopColumns  Int?     @default(4)
  showTopBar      Boolean  @default(true)
  termsPolicy     String?  @db.LongText
  privacyPolicy   String?  @db.LongText
  shippingPolicy  String?  @db.LongText
  returnsPolicy   String?  @db.LongText
  updatedAt       DateTime @updatedAt
  createdAt       DateTime @default(now())
}

model User {
  id           Int      @id @default(autoincrement())
  name         String
  username     String   @unique @default("admin")
  email        String?  @unique
  passwordHash String
  role         String   @default("ADMIN")
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
}

model Category {
  id            Int           @id @default(autoincrement())
  name          String
  slug          String        @unique
  parentId      Int?
  parent        Category?     @relation("CategorySubcategories", fields: [parentId], references: [id], onDelete: SetNull)
  subcategories Category[]    @relation("CategorySubcategories")
  imageUrl      String?       @db.VarChar(500)
  description   String?       @db.Text
  isActive      Boolean       @default(true)
  order         Int           @default(0)
  itemCount     Int           @default(0)
  items         CatalogItem[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model Occasion {
  id        Int                   @id @default(autoincrement())
  name      String
  slug      String                @unique
  iconName  String?
  isActive  Boolean               @default(true)
  items     CatalogItemOccasion[]
  createdAt DateTime              @default(now())
}

enum ItemType {
  PRODUCT
  SERVICE
}

enum Availability {
  IN_STOCK
  OUT_OF_STOCK
  ON_QUOTATION
}

enum ActionType {
  ADD_TO_CART
  SELECT_OPTIONS
  QUOTE_ONLY
}

model CatalogItem {
  id               Int                   @id @default(autoincrement())
  sku              String                @unique
  title            String
  slug             String                @unique
  brand            String?               @default("Dubro / GP")
  description      String                @db.LongText
  itemType         ItemType              @default(PRODUCT)
  scale            String                @default("RC Estándar")
  material         String                @default("Compuesto")
  specsLine        String?
  compatibleModels String?               @db.Text
  price            Decimal               @db.Decimal(10, 2)
  compareAtPrice   Decimal?              @db.Decimal(10, 2)
  discountPercent  Int?
  availability     Availability          @default(IN_STOCK)
  stockQuantity    Int                   @default(10)
  badge            String?               // "Best Seller", "Nuevo", "Popular", "Oferta"
  actionType       ActionType            @default(ADD_TO_CART)
  specifications   Json?
  variants         Json?
  images           Json                  // ["url1", "url2"]
  categoryId       Int
  category         Category              @relation(fields: [categoryId], references: [id])
  occasions        CatalogItemOccasion[]
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
}

model CatalogItemOccasion {
  itemId     Int
  occasionId Int
  item       CatalogItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  occasion   Occasion    @relation(fields: [occasionId], references: [id], onDelete: Cascade)

  @@id([itemId, occasionId])
}

enum BannerPlacement {
  HERO
  CATEGORY_PROMO
  SIDEBAR
}

model Banner {
  id         Int             @id @default(autoincrement())
  title      String
  subtitle   String?
  imageUrl   String          @db.VarChar(500)
  buttonText String?
  buttonUrl  String?
  placement  BannerPlacement @default(HERO)
  isActive   Boolean         @default(true)
  createdAt  DateTime        @default(now())
}

enum OrderStatus {
  PENDING
  IN_PREPARATION
  DELIVERED
  CANCELLED
}

model QuoteOrder {
  id               Int         @id @default(autoincrement())
  orderCode        String      @unique
  customerName     String
  customerPhone    String
  deliveryCity     String      @default("Santa Cruz")
  deliveryAddress  String      @db.Text
  customerNotes    String?     @db.Text
  items            Json
  total            Decimal     @db.Decimal(10, 2)
  status           OrderStatus @default(PENDING)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
}

model Policy {
  id        Int      @id @default(autoincrement())
  slug      String   @unique
  title     String
  content   String   @db.LongText
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

enum ClaimType {
  RECLAMO
  QUEJA
}

enum ClaimStatus {
  PENDIENTE
  EN_PROCESO
  RESUELTO
}

model ClaimRecord {
  id              Int         @id @default(autoincrement())
  trackingCode    String      @unique
  fullName        String
  documentId      String
  phone           String
  email           String
  contractedItem  String
  orderCode       String?
  amount          Decimal?    @db.Decimal(10, 2)
  type            ClaimType   @default(RECLAMO)
  detail          String      @db.LongText
  customerRequest String      @db.LongText
  status          ClaimStatus @default(PENDIENTE)
  adminNotes      String?     @db.LongText
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
}
